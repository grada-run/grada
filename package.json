{
  "name": "grada-run",
  "version": "0.36.0",
  "description": "Provision production-ready AWS infrastructure and CI/CD pipelines in seconds.",
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "bin": {
    "grada": "bin/cli.js",
    "grada-run": "bin/cli.js",
    "deploy-stack": "bin/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u",
    "test:iac": "node ./scripts/test-iac.js",
    "test:e2e:tier0": "vitest run -c vitest.e2e.tier0.config.js",
    "test:e2e:tier1": "vitest run -c vitest.e2e.tier1.config.js",
    "sync:bedrock-models": "node scripts/sync-bedrock-models.js",
    "docs:dev": "npm run dev --workspace=apps/docs",
    "docs:build": "npm run build --workspace=apps/docs"
  },
  "author": "grada-run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grada-run/grada.git"
  },
  "homepage": "https://github.com/grada-run/grada#readme",
  "bugs": {
    "url": "https://github.com/grada-run/grada/issues"
  },
  "keywords": [
    "aws",
    "terraform",
    "infrastructure-as-code",
    "devops",
    "cli",
    "github-actions",
    "ci-cd",
    "oidc",
    "serverless",
    "ecs",
    "fargate",
    "cloudfront",
    "cdn",
    "rds",
    "postgres",
    "redis",
    "dynamodb",
    "sqs",
    "ses",
    "transactional-email",
    "nodejs",
    "expressjs",
    "nestjs",
    "nextjs",
    "nextjs-deployment",
    "python",
    "fastapi",
    "django",
    "rails",
    "golang",
    "sveltekit",
    "nuxt",
    "nuxtjs",
    "astro",
    "static-site",
    "nginx",
    "docker",
    "docker-compose",
    "heroku",
    "vercel",
    "custom-domains",
    "ssl",
    "route53",
    "bedrock",
    "generative-ai",
    "preview-environments",
    "zero-downtime",
    "rollback",
    "secrets-management",
    "background-jobs",
    "database-migrations",
    "cost-optimization",
    "deploy-stack",
    "grada",
    "grada-run"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock": "3.1119.0",
    "@aws-sdk/client-cloudfront": "3.1119.0",
    "@aws-sdk/client-cloudwatch": "3.1119.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1119.0",
    "@aws-sdk/client-dynamodb": "3.1119.0",
    "@aws-sdk/client-ec2": "3.1119.0",
    "@aws-sdk/client-ecr": "3.1119.0",
    "@aws-sdk/client-ecs": "3.1119.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "3.1119.0",
    "@aws-sdk/client-rds": "3.1119.0",
    "@aws-sdk/client-s3": "3.1115.0",
    "@aws-sdk/client-secrets-manager": "3.1112.0",
    "@aws-sdk/client-sts": "3.1115.0",
    "@clack/prompts": "1.7.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dotenv": "17.4.2",
    "js-yaml": "5.4.1",
    "picocolors": "1.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "vitest": "5.0.0"
  }
}
