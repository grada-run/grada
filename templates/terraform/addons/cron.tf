# grada addon: cron
# Generated by `grada add cron`. Do not edit by hand unless
# you know what you are doing — re-running with --force overwrites this file.
#
# Billing: $0/mo fixed baseline (first 14M EventBridge Scheduler
# invocations/mo free); billed only for Fargate seconds while the task runs.

locals {
  # Length-safe names: short names render byte-identically; over-cap
  # names hash-suffix instead of failing validation. Mirrors
  # safeSuffixedName in resolvers.js.
  schedule_full_name         = "${local.app_name}-cron-{{CRON_NAME}}"
  schedule_safe_name         = length(local.schedule_full_name) > 64 ? "${trimsuffix(substr(local.schedule_full_name, 0, 64 - 1 - 5), "-")}-${substr(md5(local.schedule_full_name), 0, 5)}" : local.schedule_full_name
  schedule_group_safe_name   = length("${local.app_name}-crons") > 64 ? "${trimsuffix(substr(local.app_name, 0, 64 - 1 - 5 - 6), "-")}-${substr(md5(local.app_name), 0, 5)}-crons" : "${local.app_name}-crons"
  scheduler_policy_safe_name = length("${local.app_name}-cron-scheduler-policy") > 128 ? "${trimsuffix(substr(local.app_name, 0, 128 - 1 - 5 - 22), "-")}-${substr(md5(local.app_name), 0, 5)}-cron-scheduler-policy" : "${local.app_name}-cron-scheduler-policy"
}

# --- IAM Role assumed by EventBridge Scheduler ---
resource "aws_iam_role" "scheduler_cron_role" {
  # Deliberately unhashed: the preview guardrails carve this exact
  # principal out of the task-execution deny, and a hashed name would
  # silently uncarve it. Over-cap names fail the precondition below
  # at plan time instead of breaking schedules silently.
  name                 = "${local.app_name}-cron-scheduler-role"
  permissions_boundary = local.preview_boundary_arn
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Service = "scheduler.amazonaws.com"
        }
        Action = "sts:AssumeRole"
      }
    ]
  })

  lifecycle {
    precondition {
      condition     = length("${local.app_name}-cron-scheduler-role") <= 64
      error_message = "Project name is too long: the scheduler role name exceeds the 64-char IAM cap. Shorten the project name (max 26 chars keeps every derived name within caps)."
    }
  }
}

# --- Least-privilege permission to launch the scheduled task ---
resource "aws_iam_role_policy" "scheduler_cron_policy" {
  name = local.scheduler_policy_safe_name
  role = aws_iam_role.scheduler_cron_role.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = ["ecs:RunTask"]
        Resource = [
          aws_ecs_task_definition.app.arn,
          "${aws_ecs_task_definition.app.arn_without_revision}:*"
        ]
      },
      {
        Effect = "Allow"
        Action = ["iam:PassRole"]
        Resource = [
          aws_iam_role.execution_role.arn,
          aws_iam_role.task_role.arn
        ]
        Condition = {
          StringLike = {
            "iam:PassedToService" = "ecs-tasks.amazonaws.com"
          }
        }
      }
    ]
  })
}

# --- Schedule group (failure metrics scope) ---
# Scheduler metrics dimension by group only (no per-schedule dimension),
# so the project's schedules get their own group instead of the shared
# default one — the alerts.tf failure alarms stay project-scoped.
resource "aws_scheduler_schedule_group" "crons" {
  name = local.schedule_group_safe_name
}

# --- Scheduled task (single schedule per project) ---
resource "aws_scheduler_schedule" "cron" {
  name                         = local.schedule_safe_name
  group_name                   = aws_scheduler_schedule_group.crons.name
  schedule_expression          = "{{SCHEDULE_EXPRESSION}}"
  schedule_expression_timezone = "{{SCHEDULE_TIMEZONE}}"
  # Sleep guard: stays disabled while grada sleep's auto-vars are active
  # so a raw apply never re-enables a paused schedule.
  state = var.asleep ? "DISABLED" : "ENABLED"

  flexible_time_window {
    mode = "OFF"
  }

  target {
    arn      = aws_ecs_cluster.main.arn
    role_arn = aws_iam_role.scheduler_cron_role.arn

    ecs_parameters {
      task_definition_arn = aws_ecs_task_definition.app.arn
      launch_type         = "FARGATE"
      task_count          = 1

      network_configuration {
        subnets          = aws_subnet.public[*].id
        security_groups  = [aws_security_group.ecs_tasks.id]
        assign_public_ip = true
      }
    }

    input = jsonencode({
      containerOverrides = [
        {
          name    = "${local.app_name}-container"
          command = ["sh", "-c", {{CRON_COMMAND_JSON}}]
        }
      ]
    })
  }
}

# --- Outputs ---
output "cron_schedule_name" {
  value = aws_scheduler_schedule.cron.name
}

output "cron_schedule_arn" {
  value = aws_scheduler_schedule.cron.arn
}
